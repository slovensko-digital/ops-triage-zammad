<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <title><%= content_for?(:title) ? "#{yield(:title)} · " : '' %><%= t('ops.layout.site') %></title>
  <%= csrf_meta_tags %>
  <%= yield :head %>
  <script src="/assets/ops-user-autocomplete.js?v<%= Rails.public_path.join('assets/ops-user-autocomplete.js').mtime.to_i %>" defer></script>
  <script src="/assets/ops-run-watch.js?v<%= Rails.public_path.join('assets/ops-run-watch.js').mtime.to_i %>" defer></script>
  <style>
    body { font: 14px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; margin: 0; color: #1f2328; background: #f6f8fa; }
    header { background: #24292f; color: #fff; padding: 10px 24px; }
    header a { color: #fff; text-decoration: none; margin-right: 16px; }
    main { padding: 16px 24px 48px; max-width: 1400px; }
    nav.tabs { display: flex; gap: 4px; border-bottom: 1px solid #d0d7de; margin-bottom: 16px; }
    nav.tabs a { padding: 8px 14px; color: #1f2328; text-decoration: none; border: 1px solid transparent; border-bottom: 0;
      border-radius: 6px 6px 0 0; margin-bottom: -1px; }
    nav.tabs a:hover { background: #eaeef2; }
    nav.tabs a.active { background: #fff; border-color: #d0d7de; font-weight: 600; }
    h1 { font-size: 20px; } h2 { font-size: 16px; margin-top: 28px; }
    table { border-collapse: collapse; background: #fff; width: 100%; }
    th, td { border: 1px solid #d0d7de; padding: 5px 8px; text-align: left; vertical-align: top; }
    th { background: #f0f3f6; }
    pre { background: #fff; border: 1px solid #d0d7de; padding: 10px; overflow-x: auto; white-space: pre-wrap; font-size: 12px; }
    .alert { background: #ffebe9; border: 1px solid #ff8182; padding: 8px 12px; margin: 12px 0; white-space: pre-wrap; }
    .notice { background: #ddf4ff; border: 1px solid #54aeff; padding: 8px 12px; margin: 12px 0; }
    .muted { color: #656d76; }
    .warn { color: #cf222e; }
    .status-queued, .status-running { color: #9a6700; font-weight: 600; }
    .status-done { color: #1a7f37; font-weight: 600; }
    .status-failed { color: #cf222e; font-weight: 600; }
    form.inline { display: inline; }
    fieldset { background: #fff; border: 1px solid #d0d7de; margin: 12px 0; }
    label { margin-right: 12px; }
    button { cursor: pointer; }
    .user-autocomplete { position: relative; display: inline-block; }
    .user-autocomplete-query { width: 360px; }
    .user-autocomplete-results { position: absolute; z-index: 10; left: 0; top: 100%; min-width: 100%; max-height: 320px; overflow-y: auto;
      margin: 2px 0 0; padding: 4px 0; list-style: none; background: #fff; border: 1px solid #d0d7de; border-radius: 4px;
      box-shadow: 0 4px 12px rgba(0, 0, 0, .12); }
    .user-autocomplete-results li { padding: 5px 10px; cursor: pointer; white-space: nowrap; }
    .user-autocomplete-results li.active, .user-autocomplete-results li[data-index]:hover { background: #ddf4ff; }
    .user-autocomplete-results li.empty { color: #656d76; cursor: default; }
    .user-autocomplete-results .email { color: #656d76; margin-left: 8px; }
    .next { background: #fff; border: 1px solid #d0d7de; border-left: 4px solid #0969da; padding: 10px 14px; margin: 12px 0; }
    .step { margin: 10px 0; }
    button.danger { background: #cf222e; color: #fff; border: 1px solid #a40e26; padding: 4px 12px; }
  </style>
</head>
<body>
  <header>
    <a href="/#"><%= t('ops.layout.back_to_triage') %></a>
    <a href="<%= ops_owner_handovers_path %>"><%= t('ops.layout.owner_handover') %></a>
  </header>
  <main>
    <%= yield :tabs %>
    <% if flash[:alert] %><div class="alert"><%= flash[:alert] %></div><% end %>
    <% if flash[:notice] %><div class="notice"><%= flash[:notice] %></div><% end %>
    <%= yield %>
  </main>
</body>
</html>
