<%# The layout 'ops' with the tabs of the owner handover pages, see Ops::OwnerHandoverPages %>
<% content_for :tabs do %>
  <nav class="tabs">
    <% { hand_over: ops_owner_handovers_path, conflicts: conflicts_ops_owner_handovers_path,
         runs: ops_owner_handover_runs_path }.each do |name, path| %>
      <%= link_to ot("tabs.#{name}"), path, class: ('active' if tab == name) %>
    <% end %>
  </nav>
<% end %>
<%= render template: 'layouts/ops' %>
