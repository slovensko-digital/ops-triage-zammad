<% content_for :title, 'Jobs' %>
<p class="muted">The steps applied, the last 30.</p>
<% if @runs.empty? %>
  <p class="muted">No jobs yet.</p>
<% else %>
  <table>
    <tr>
      <th>#</th><th>Type</th><th>From</th><th>To</th>
      <th>Groups</th><th>Status</th><th>Queued</th>
      <th>Finished</th><th>By</th>
    </tr>
    <% @runs.each do |run| %>
      <tr>
        <td><%= link_to "##{run.id}", ops_owner_handover_run_path(run) %></td>
        <td><%= step_name(run.step) %></td>
        <td><%= link_to run.old_owner.email, ops_owner_handover_path(run.old_owner) %></td>
        <td><%= run.routed? ? 'owners by trigger' : run.new_owner.email %></td>
        <td><%= run.groups.presence&.join(', ') || 'all' %></td>
        <td class="status-<%= run.status %>" <%= "data-run-id=#{run.id}".html_safe if run.active? %>><%= run.status %></td>
        <td><%= run.created_at %></td>
        <td><%= run.finished_at %></td>
        <td><%= run.created_by&.email %></td>
      </tr>
    <% end %>
  </table>
<% end %>
