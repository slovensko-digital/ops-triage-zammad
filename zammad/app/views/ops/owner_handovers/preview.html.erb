<% content_for :title, "Dry run: #{@run.step}" %>
<h1>Dry run: <%= @run.step %></h1>
<table>
  <tr><th>From</th><td><%= link_to @run.old_owner_email, ops_owner_handover_report_path(email: @run.old_owner_email) %></td></tr>
  <tr><th>To</th><td><%= @run.new_owner_email %></td></tr>
  <tr><th>Groups</th><td><%= @run.groups.presence&.join(', ') || 'all' %></td></tr>
</table>

<% if @run.errors.any? %>
  <div class="alert"><%= @run.errors.full_messages.join("\n") %></div>
<% elsif @error %>
  <div class="alert"><%= @error %></div>
  <% if @output.present? %><pre><%= @output %></pre><% end %>
<% else %>
  <pre><%= @output %></pre>

  <fieldset>
    <legend>Apply</legend>
    <%= form_with url: ops_owner_handover_runs_path, method: :post do %>
      <%= hidden_field_tag :step, @run.step %>
      <%= hidden_field_tag :old_email, @run.old_owner_email %>
      <%= hidden_field_tag :new_email, @run.new_owner_email %>
      <% Array(@run.groups).each do |group| %><%= hidden_field_tag 'groups[]', group, id: nil %><% end %>
      <p class="muted">Runs right away, in the background. Checked again when it runs, the result can differ from this dry run.</p>
      <button type="submit" class="danger">Apply</button>
    <% end %>
  </fieldset>
<% end %>
