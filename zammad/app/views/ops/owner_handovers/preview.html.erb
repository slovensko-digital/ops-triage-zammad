<% step = params[:step].to_s %>
<% content_for :title, ot('preview.title', step: step_name(step)) %>
<h1><%= ot('preview.title', step: step_name(step)) %></h1>
<p><%= link_to ot('back_to_handover', email: params[:old_email]), ops_owner_handover_report_path(email: params[:old_email]) %></p>

<% if @error %>
  <div class="alert"><%= @error %></div>
<% else %>
  <% @outputs.each do |run, output, error| %>
    <table>
      <tr><th><%= ot('columns.from') %></th><td><%= run.old_owner_email %></td></tr>
      <tr><th><%= ot('columns.to') %></th><td><%= run.routed? ? ot('routed_owners_long') : run.new_owner_email %></td></tr>
      <tr><th><%= ot('columns.groups') %></th><td><%= run.groups.presence&.join(', ') || ot('all_groups') %></td></tr>
    </table>
    <% if error %><div class="alert"><%= error %></div><% end %>
    <% if output.present? %><pre><%= output %></pre><% end %>
  <% end %>

  <% if @outputs.none? { |_run, _output, error| error } %>
    <fieldset>
      <legend><%= ot('preview.apply') %></legend>
      <%= form_with url: ops_owner_handover_runs_path, method: :post do %>
        <%= hidden_field_tag :step, step %>
        <%= hidden_field_tag :old_email, params[:old_email] %>
        <%= hidden_field_tag :new_email, params[:new_email] %>
        <% Array(params[:groups]).each do |group| %><%= hidden_field_tag 'groups[]', group, id: nil %><% end %>
        <% @runs.select { |run| run.step == 'triggers' }.each do |run| %>
          <% run.groups.each do |group| %><%= hidden_field_tag "owners[#{group}]", run.new_owner_email, id: nil %><% end %>
        <% end %>
        <p class="muted">
          <%= @runs.size > 1 ? ot('preview.apply_help_several', count: @runs.size) : ot('preview.apply_help') %>
        </p>
        <button type="submit" class="danger"><%= ot('preview.apply') %></button>
      <% end %>
    </fieldset>
  <% end %>
<% end %>
