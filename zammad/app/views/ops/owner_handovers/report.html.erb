<% content_for :title, ot('report.title', email: @old_owner.email) %>
<%
  to_hand_over = @groups.fetch(:triggers, [])
  to_move = @groups.fetch(:tickets, [])
  attention = @groups.fetch(:attention, [])
  done = @groups.fetch(:done, [])
  ready = to_move.reject { |group| busy_run(group.label) }
  active_runs = @runs.select(&:active?)
  tickets_cell = lambda do |group|
    group.test_tickets.positive? ? ot('with_test', tickets: group.tickets, test: group.test_tickets) : group.tickets
  end
  busy_link = ->(run) { link_to ot('run_link', id: run.id, status: status_name(run.status)), ops_owner_handover_run_path(run) }
%>
<h1><%= ot('report.heading', user: describe_user(@old_owner)) %></h1>

<div class="next">
  <% if active_runs.any? %>
    <%= ot('report.running_html', runs: active_runs.map { |run| "##{run.id} #{step_name(run.step)}" }.join(', ')) %>
  <% elsif to_hand_over.any? %>
    <%= ot('report.next_triggers_html') %>
  <% elsif to_move.any? %>
    <%= ot('report.next_tickets_html') %>
  <% elsif attention.any? %>
    <%= ot('report.next_attention_html') %>
  <% else %>
    <%= ot('report.complete_html') %>
  <% end %>
</div>

<% if @runs.any? %>
  <h2><%= ot('report.runs_heading') %></h2>
  <div id="runs-finished" class="notice" hidden><%= ot('report.run_ended_html') %></div>
  <table>
    <tr>
      <th>#</th><th><%= ot('columns.step') %></th><th><%= ot('columns.to') %></th><th><%= ot('columns.groups') %></th>
      <th><%= ot('columns.status') %></th><th><%= ot('columns.queued') %></th><th><%= ot('columns.by') %></th>
    </tr>
    <% @runs.first(5).each do |run| %>
      <tr>
        <td><%= link_to "##{run.id}", ops_owner_handover_run_path(run) %></td>
        <td><%= step_name(run.step) %></td>
        <td><%= run.routed? ? ot('routed_owners') : run.new_owner_email %></td>
        <td><%= run.groups.presence&.join(', ') || ot('all_groups') %></td>
        <td class="status-<%= run.status %>" <%= "data-run-id=#{run.id}".html_safe if run.active? %>><%= status_name(run.status) %></td>
        <td><%= time_in_zone(run.created_at) %></td>
        <td><%= run.created_by&.email %></td>
      </tr>
    <% end %>
  </table>
  <p class="muted"><%= link_to ot('report.all_runs'), ops_owner_handover_runs_path %></p>
<% end %>

<h2><%= ot('report.triggers_heading', count: to_hand_over.size) %></h2>
<% if to_hand_over.empty? %>
  <p class="muted"><%= ot('report.no_triggers') %></p>
<% else %>
  <p class="muted"><%= ot('report.triggers_help') %></p>
  <table>
    <tr>
      <th><%= ot('columns.group') %></th><th><%= ot('columns.trigger') %></th><th><%= ot('columns.tickets') %></th>
      <th><%= ot('columns.new_owner') %></th>
    </tr>
    <% to_hand_over.each do |group| %>
      <tr>
        <td><%= group.label %></td>
        <td>
          <% group.triggers.each do |trigger| %>
            #<%= trigger.id %> <span class="<%= trigger.active ? '' : 'muted' %>"><%= "#{ot('inactive')} " unless trigger.active %><%= trigger.name %></span><br>
          <% end %>
          <% if group.triggers.size > 1 %><span class="warn"><%= ot('report.several_triggers') %></span><% end %>
        </td>
        <td><%= tickets_cell.call(group) %></td>
        <td>
          <% if (run = busy_run(group.label)) %>
            <%= busy_link.call(run) %>
          <% else %>
            <%= render 'agent_field', name: "owners[#{group.label}]", form: 'triggers-form' %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </table>
  <%= form_with url: ops_owner_handover_preview_path, method: :post, id: 'triggers-form', class: 'step' do %>
    <%= hidden_field_tag :step, 'triggers' %>
    <%= hidden_field_tag :old_email, @old_owner.email %>
    <button type="submit"><%= ot('report.preview_triggers') %></button>
  <% end %>
<% end %>

<h2><%= ot('report.tickets_heading', count: to_move.size) %></h2>
<% if to_move.empty? %>
  <p class="muted"><%= to_hand_over.any? ? ot('report.tickets_wait') : ot('report.no_tickets') %></p>
<% else %>
  <p class="muted"><%= ot('report.tickets_help') %></p>
  <table>
    <tr>
      <th><%= ot('columns.group') %></th><th><%= ot('columns.tickets') %></th><th><%= ot('columns.goes_to') %></th><th></th>
    </tr>
    <% to_move.each do |group| %>
      <tr>
        <td><%= group.label %></td>
        <td><%= tickets_cell.call(group) %></td>
        <td><%= describe_user(group.routed_owner) %></td>
        <td>
          <% if (run = busy_run(group.label)) %>
            <%= busy_link.call(run) %>
          <% else %>
            <%= render 'preview_button', step: 'tickets_routed', old_email: @old_owner.email, new_email: nil,
                                         groups: [group.label], label: ot('report.preview_group') %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </table>
  <% if ready.any? %>
    <div class="step">
      <%= render 'preview_button', step: 'tickets_routed', old_email: @old_owner.email, new_email: nil,
                                   groups: ready.map(&:label), label: ot('report.preview_tickets', count: ready.size) %>
    </div>
  <% end %>
<% end %>

<% if attention.any? %>
  <h2 class="warn"><%= ot('report.attention_heading', count: attention.size) %></h2>
  <p class="muted"><%= ot('report.attention_help') %></p>
  <table>
    <tr><th><%= ot('columns.group') %></th><th><%= ot('columns.tickets') %></th><th><%= ot('columns.routing_now') %></th></tr>
    <% attention.each do |group| %>
      <tr><td><%= group.label %></td><td><%= group.tickets %></td><td class="warn"><%= routing_text(group.routes) %></td></tr>
    <% end %>
  </table>
<% end %>

<% if done.any? %>
  <h2><%= ot('report.done_heading', count: done.size) %></h2>
  <p class="muted"><%= ot('report.done_help', groups: done.map { |group| "#{group.label} (#{group.test_tickets})" }.join(', ')) %></p>
<% end %>

<details>
  <summary><%= ot('report.full_report_html') %></summary>
  <pre><%= @report %></pre>
</details>
