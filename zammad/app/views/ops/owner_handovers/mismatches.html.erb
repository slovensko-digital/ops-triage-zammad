<% content_for :title, 'Owner mismatches' %>
<p>Groups with tickets not owned by their owner by trigger: <%= @mismatches.size %></p>
<p class="muted">"Preview move" is a dry run, nothing changes before you apply it.</p>
<% if @mismatches.empty? %>
  <p>No mismatches.</p>
<% else %>
  <table>
    <tr>
      <th>Group</th><th>Owner by trigger</th><th>Other owner</th>
      <th>Tickets (open)</th><th></th>
    </tr>
    <% @mismatches.sort_by { |mismatch| mismatch.group.name }.each do |mismatch| %>
      <% routed = mismatch.routed_owner && User.find_by(id: mismatch.routed_owner) %>
      <% label = mismatch.group.name.split('::').join(' / ') %>
      <% mismatched = mismatch.mismatched_owners.sort_by { |owner_id| -mismatch.tickets_by_owner[owner_id].size } %>
      <% mismatched.each_with_index do |owner_id, index| %>
        <% owner = User.find_by(id: owner_id) %>
        <% tickets = mismatch.tickets_by_owner[owner_id] %>
        <tr>
          <% if index.zero? %>
            <td rowspan="<%= mismatched.size %>"><%= label %></td>
            <td rowspan="<%= mismatched.size %>">
              <% if routed %>
                <%= describe_user(routed) %>
                <% if mismatch.tickets_by_owner[routed.id] %><br><span class="muted">owns <%= mismatch.tickets_by_owner[routed.id].size %> here</span><% end %>
              <% else %>
                <span class="warn"><%= routing_text(mismatch.routed_owners) %></span>
              <% end %>
            </td>
          <% end %>
          <td>
            <% if owner %>
              <%= link_to describe_user(owner), ops_owner_handover_path(owner) %>
            <% else %>
              unknown user #<%= owner_id %>
            <% end %>
          </td>
          <td><%= tickets.size %> (<%= tickets.count { |state_id, _id, _created_at| @open_state_ids.include?(state_id) } %>)</td>
          <td>
            <% if routed && owner %>
              <%= render 'preview_button', step: 'tickets', old_owner: owner, new_owner_id: routed.id,
                                           groups: [label], label: 'Preview move to the owner by trigger' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% end %>
  </table>
<% end %>
