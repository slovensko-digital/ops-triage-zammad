<% content_for :title, ot('conflicts.title') %>
<p><%= ot('conflicts.count', count: @conflicts.size) %></p>
<p class="muted"><%= ot('conflicts.help') %></p>
<% if @conflicts.empty? %>
  <p><%= ot('conflicts.none') %></p>
<% else %>
  <table>
    <tr>
      <th><%= ot('columns.group') %></th><th><%= ot('columns.routed_owner') %></th><th><%= ot('columns.other_owner') %></th>
      <th><%= ot('columns.tickets_open') %></th><th></th>
    </tr>
    <% @conflicts.sort_by { |conflict| conflict.group.name }.each do |conflict| %>
      <% routed = conflict.routed_owner && User.find_by(id: conflict.routed_owner) %>
      <% label = conflict.group.name.split('::').join(' / ') %>
      <% strays = conflict.stray_owners.sort_by { |owner_id| -conflict.tickets_by_owner[owner_id].size } %>
      <% strays.each_with_index do |owner_id, index| %>
        <% owner = User.find_by(id: owner_id) %>
        <% tickets = conflict.tickets_by_owner[owner_id] %>
        <tr>
          <% if index.zero? %>
            <td rowspan="<%= strays.size %>"><%= label %></td>
            <td rowspan="<%= strays.size %>">
              <% if routed %>
                <%= describe_user(routed) %>
                <% if conflict.tickets_by_owner[routed.id] %><br><span class="muted"><%= ot('conflicts.owns_here', count: conflict.tickets_by_owner[routed.id].size) %></span><% end %>
              <% else %>
                <span class="warn"><%= routing_text(conflict.routed_owners) %></span>
              <% end %>
            </td>
          <% end %>
          <td>
            <% if owner %>
              <%= link_to describe_user(owner), ops_owner_handover_path(owner) %>
            <% else %>
              <%= ot('unknown_user', id: owner_id) %>
            <% end %>
          </td>
          <td><%= tickets.size %> (<%= tickets.count { |state_id, _id, _created_at| @open_state_ids.include?(state_id) } %>)</td>
          <td>
            <% if routed && owner %>
              <%= render 'preview_button', step: 'tickets', old_owner: owner, new_email: routed.email,
                                           groups: [label], label: ot('conflicts.preview_move') %>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% end %>
  </table>
<% end %>
