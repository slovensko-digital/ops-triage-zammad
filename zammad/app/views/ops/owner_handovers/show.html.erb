<% content_for :title, "Hand over #{@old_owner.email}" %>
<%
  to_hand_over = @groups.fetch(:triggers, [])
  to_move = @groups.fetch(:tickets, [])
  attention = @groups.fetch(:attention, [])
  done = @groups.fetch(:done, [])
  ready = to_move.reject { |group| busy_run(group.label) }
  active_runs = @runs.select(&:active?)
  tickets_cell = lambda do |group|
    group.test_tickets.positive? ? "#{group.tickets} + #{group.test_tickets} test" : group.tickets
  end
  busy_link = ->(run) { link_to "job ##{run.id} #{run.status}", ops_owner_handover_run_path(run) }
%>
<h1>Hand over <%= describe_user(@old_owner) %></h1>

<div class="next">
  <% if active_runs.any? %>
    <strong>Running:</strong> <%= active_runs.map { |run| "##{run.id} #{step_name(run.step)}" }.join(', ') %>. This page updates when it ends.
  <% elsif to_hand_over.any? %>
    <strong>Next: 1. hand over the triggers</strong>, pick a new owner for each group below.
  <% elsif to_move.any? %>
    <strong>Next: 2. move the tickets</strong> below.
  <% elsif attention.any? %>
    <strong>Next: fix the triggers</strong> of the groups below in Zammad.
  <% else %>
    <strong>Handover complete.</strong>
  <% end %>
</div>

<% if @runs.any? %>
  <h2>Jobs for this owner</h2>
  <div id="runs-finished" class="notice" hidden>A job ended. <a href="">Reload the page</a> to see where the groups are now (the new owners you picked are kept only until then).</div>
  <table>
    <tr>
      <th>#</th><th>Type</th><th>To</th><th>Groups</th>
      <th>Status</th><th>Queued</th><th>By</th>
    </tr>
    <% @runs.first(5).each do |run| %>
      <tr>
        <td><%= link_to "##{run.id}", ops_owner_handover_run_path(run) %></td>
        <td><%= step_name(run.step) %></td>
        <td><%= run.routed? ? 'owners by trigger' : run.new_owner.email %></td>
        <td><%= run.groups.presence&.join(', ') || 'all' %></td>
        <td class="status-<%= run.status %>" <%= "data-run-id=#{run.id}".html_safe if run.active? %>><%= run.status %></td>
        <td><%= run.created_at %></td>
        <td><%= run.created_by&.email %></td>
      </tr>
    <% end %>
  </table>
  <p class="muted"><%= link_to 'All jobs', ops_owner_handover_runs_path %></p>
<% end %>

<h2>1. Triggers (<%= to_hand_over.size %>)</h2>
<% if to_hand_over.empty? %>
  <p class="muted">No trigger routes a group to this owner anymore.</p>
<% else %>
  <p class="muted">
    Pick the new owner of each group, groups left empty stay as they are. The new owner gets access to the group and
    the new tickets of the group go to them. The tickets already there move in step 2.
  </p>
  <table>
    <tr>
      <th>Group</th><th>ID</th><th>Trigger</th><th>Active</th><th>Tickets</th>
      <th>New owner</th>
    </tr>
    <% to_hand_over.each do |group| %>
      <% rows = group.triggers.size %>
      <% group.triggers.each_with_index do |trigger, index| %>
        <tr>
          <% if index.zero? %>
            <td rowspan="<%= rows %>">
              <%= group.label %>
              <% if rows > 1 %><br><span class="warn">several triggers, a group should have one: all move to the new owner</span><% end %>
            </td>
          <% end %>
          <td class="<%= 'muted' unless trigger.active %>">#<%= trigger.id %></td>
          <td class="<%= 'muted' unless trigger.active %>"><%= trigger.name %></td>
          <td class="<%= 'muted' unless trigger.active %>"><%= trigger.active ? 'yes' : 'no' %></td>
          <% if index.zero? %>
            <td rowspan="<%= rows %>"><%= tickets_cell.call(group) %></td>
            <td rowspan="<%= rows %>">
              <% if (run = busy_run(group.label)) %>
                <%= busy_link.call(run) %>
              <% else %>
                <%= render 'agent_field', name: "owners[#{group.label}]", form: 'triggers-form' %>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    <% end %>
  </table>
  <%= form_with url: preview_ops_owner_handover_path(@old_owner), method: :post, id: 'triggers-form', class: 'step' do %>
    <%= hidden_field_tag :step, 'triggers' %>
    <button type="submit">Preview the trigger handover</button>
  <% end %>
<% end %>

<h2>2. Tickets (<%= to_move.size %>)</h2>
<% if to_move.empty? %>
  <p class="muted"><%= to_hand_over.any? ? 'The groups come here once their trigger is handed over.' : 'No tickets to move.' %></p>
<% else %>
  <p class="muted">
    The tickets (closed ones too) go to the owner the group's trigger routes it to, without notifications. Test
    tickets stay with this owner.
  </p>
  <table>
    <tr>
      <th>Group</th><th>Tickets</th><th>Goes to</th><th></th>
    </tr>
    <% to_move.each do |group| %>
      <tr>
        <td><%= group.label %></td>
        <td><%= tickets_cell.call(group) %></td>
        <td><%= describe_user(group.routed_owner) %></td>
        <td>
          <% if (run = busy_run(group.label)) %>
            <%= busy_link.call(run) %>
          <% else %>
            <%= render 'preview_button', step: 'tickets_routed', old_owner: @old_owner, new_owner_id: nil,
                                         groups: [group.label], label: 'Preview this group' %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </table>
  <% if ready.any? %>
    <div class="step">
      <%= render 'preview_button', step: 'tickets_routed', old_owner: @old_owner, new_owner_id: nil,
                                   groups: ready.map(&:label), label: "Preview moving the tickets of #{pluralize(ready.size, 'group')}" %>
    </div>
  <% end %>
<% end %>

<% if attention.any? %>
  <h2 class="warn">Needs attention (<%= attention.size %>)</h2>
  <p class="muted">
    Tickets left, but no single active trigger routes the group to another owner. Fix the group's trigger in Zammad,
    then reload this page.
  </p>
  <table>
    <tr><th>Group</th><th>Tickets</th><th>Routing now</th></tr>
    <% attention.each do |group| %>
      <tr><td><%= group.label %></td><td><%= group.tickets %></td><td class="warn"><%= routing_text(group.routes) %></td></tr>
    <% end %>
  </table>
<% end %>

<% if done.any? %>
  <h2>Done (<%= done.size %>)</h2>
  <p class="muted">Only test tickets left, they stay with this owner: <%= done.map { |group| "#{group.label} (#{group.test_tickets})" }.join(', ') %></p>
<% end %>

<details>
  <summary>Full text report (the same as <code>rake ops:owner_handover:report</code>)</summary>
  <pre><%= @report %></pre>
</details>
